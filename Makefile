# Generated by Praetor from declared project commands; execution is unverified.
-include .config/praetor/engine.mk
# Praetor ships one binary under two names; resolve whichever is installed.
PRAETORCTL ?= $(shell command -v praetorctl 2>/dev/null || command -v standardsctl 2>/dev/null || echo praetorctl)
.PHONY: all verify-all compile-context compile-context-verify caveman-sources audit build test

all: build

verify-all: compile-context-verify caveman-sources audit test

compile-context:
	@$(PRAETORCTL) compile-context

compile-context-verify:
	@$(PRAETORCTL) compile-context --verify

caveman-sources:
	@$(PRAETORCTL) caveman check --configured-sources

audit:
	@$(PRAETORCTL) audit

# The sandbox's verification is its release cycle against the forge (.github/workflows/cycle.yml);
# locally the workflows and the cycle's scripts are linted.
test: build
	@python3 -m unittest discover -s tests
	@actionlint
	@bash -n .github/scripts/watch-run.sh

build:
	@python3 -c 'import ast, sys; ast.parse(open(sys.argv[1], encoding="utf-8").read(), sys.argv[1])' .github/scripts/check-cycle.py
	@python3 -c 'import ast, sys; ast.parse(open(sys.argv[1], encoding="utf-8").read(), sys.argv[1])' .github/scripts/land.py
